LIVE = Path(
    r"D:\xuxinzhi\ComfyUI_windows_portable_nvidia\ComfyUI_windows_portable"
    r"\ComfyUI\user\default\workflows\MeinaMix_雯宝LoRA_换装抠图.json"
)
REPO = TOOLS / "workflows" / "MeinaMix_雯宝LoRA_换装抠图.json"
STAGE = Path(r"C:\Users\ZhuanZ1\Desktop\wenbebi\tools\out\wenbao-assets\_compare")
CLIENT_ID = "wenbebi-official-dress"


def request(method: str, path: str, data=None, timeout=60):
    body = None
    headers = {}
    if data is not None:
        body = json.dumps(data).encode("utf-8")
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(COMFY + path, data=body, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read()
            return json.loads(raw.decode("utf-8")) if raw else None
    except urllib.error.HTTPError as e:
        err = e.read().decode("utf-8", "replace")
        raise SystemExit(f"HTTP {e.code} {path}: {err}") from e


def free_cache():
    request("POST", "/free", {"unload_models": True, "free_memory": True})
    print("freed Comfy cache")


def queue_graph(graph: dict, timeout_s: int = 600) -> dict:
    submit = request("POST", "/prompt", {"client_id": CLIENT_ID, "prompt": graph})
    if not submit or "prompt_id" not in submit:
        raise SystemExit(f"no prompt_id: {submit}")
    if submit.get("node_errors"):
        raise SystemExit(f"node_errors: {json.dumps(submit['node_errors'], indent=2, ensure_ascii=False)}")
    prompt_id = submit["prompt_id"]
    print(f"queued {prompt_id}")
    start = time.time()
    while time.time() - start < timeout_s:
        time.sleep(1.5)
        try:
            hist = request("GET", f"/history/{urllib.parse.quote(prompt_id)}", timeout=30)
        except Exception as e:
            print(f"history poll error: {e}")
            continue
        record = (hist or {}).get(prompt_id)
        if not record:
            continue
        status = record.get("status") or {}
        if status.get("completed") is False and status.get("status_str") == "error":
            raise SystemExit(f"Comfy error: {json.dumps(status, indent=2)[:4000]}")
        outputs = record.get("outputs") or {}
        images = []
        for node_id, node_out in outputs.items():
            for img in node_out.get("images") or []:
                images.append({"nodeId": str(node_id), **img})
        if images:
            print(f"completed {prompt_id} in {time.time()-start:.1f}s, {len(images)} image(s)")
            return {"prompt_id": prompt_id, "record": record, "images": images}
        if status.get("status_str") == "error":
            raise SystemExit(f"Comfy error: {json.dumps(status, indent=2)[:4000]}")
    raise SystemExit(f"timeout waiting for {prompt_id}")


def download_image(img: dict, dest: Path) -> int:
    q = urllib.parse.urlencode(
        {
            "filename": img["filename"],
            "subfolder": img.get("subfolder") or "",
            "type": img.get("type") or "output",
        }
    )
    dest.parent.mkdir(parents=True, exist_ok=True)
    with urllib.request.urlopen(f"{COMFY}/view?{q}", timeout=120) as resp:
        data = resp.read()
    dest.write_bytes(data)
    print(f"saved {dest} ({len(data)} bytes) from {img['filename']} node {img.get('nodeId')}")
    return len(data)


def classify(img: dict) -> str:
    fn = img.get("filename") or ""
    nid = str(img.get("nodeId") or "")
    if "PoseSkel" in fn or nid == "28":
        return "poseskel"
    if "AnimeSharp4x" in fn or nid == "42":
        return "animesharp4x_raw"
    if "AnimeSharp2x" in fn or nid == "44":
        return "animesharp2x_raw"
    if "Cutout" in fn or nid == "17":
        return "deprecated_cutout"
    if nid == "9" or "Wenbao_Raw" in fn:
        return "raw"
    return "other"


def try_official_rematte(src: Path, stem: str, outdir: Path) -> bool:
    script = TOOLS / "official-isnet-rematte.py"
    if not script.is_file():
        print(f"official rematte script missing: {script}")
        return False
    try:
        import rembg  # noqa: F401
    except Exception:
        print(
            "rembg not importable on this interpreter; run the official post-step "
            f"where rembg+isnet-anime is installed:\n"
            f"  python {script} --src {src} --stem {stem} --outdir {outdir}"
        )
        return False
    import subprocess

    cmd = [sys.executable, str(script), "--src", str(src), "--stem", stem, "--outdir", str(outdir)]
    print("running official rematte:", " ".join(cmd))
    rc = subprocess.call(cmd)
    if rc != 0:
        raise SystemExit(f"official isnet rematte failed with {rc}")
    return True


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--name", default="character-xiaoyan-official-compare.png")
    p.add_argument("--seed", type=int, default=None, help="Override KSampler seed only; prompts come from official JSON")
    p.add_argument("--workflow", default="", help="Official UI workflow path")
    p.add_argument("--no-free", action="store_true")
    p.add_argument("--skip-rematte", action="store_true")
    args = p.parse_args()

    wf = Path(args.workflow) if args.workflow else (LIVE if LIVE.is_file() else REPO)
    if not wf.is_file():
        raise SystemExit(f"official workflow not found: {wf}")
    print(f"loading official workflow {wf}")
    graph = load_official_api(wf)
    # safety: never submit muted color-key even if converter missed mode
    for banned in ("14", "15", "16", "17", "18", "19"):
        if banned in graph:
            print(f"dropping leftover color-key node {banned} {graph[banned].get('class_type')}")
            graph.pop(banned)
    if args.seed is not None:
        if "3" not in graph or graph["3"].get("class_type") != "KSampler":
            raise SystemExit("official graph missing KSampler node 3")
        graph["3"]["inputs"]["seed"] = int(args.seed)
        print(f"seed override {args.seed} (prompts unchanged from official JSON)")

    # summary
    pos = (graph.get("6") or {}).get("inputs", {}).get("text")
    neg = (graph.get("7") or {}).get("inputs", {}).get("text")
    face = (graph.get("21") or {}).get("inputs", {}).get("image")
    pose = (graph.get("23") or {}).get("inputs", {}).get("image")
    print(json.dumps({"workflow": str(wf), "face": face, "pose": pose, "seed": args.seed, "nodes": list(graph)}, ensure_ascii=False, indent=2))
    print("POSITIVE:", pos)
    print("NEGATIVE:", neg)

    if not args.no_free:
        free_cache()
        time.sleep(1)

    result = queue_graph(graph, timeout_s=600)
    stem = args.name.replace(".png", "")
    STAGE.mkdir(parents=True, exist_ok=True)
    (STAGE / "raw").mkdir(parents=True, exist_ok=True)
    saved = {}
    for img in result["images"]:
        kind = classify(img)
        if kind == "deprecated_cutout":
            print(f"WARNING: official graph still emitted cutout {img}; not staging as formal matte")
            dest = STAGE / f"{stem}_DEPRECATED_colorkey_{img['filename']}"
        elif kind == "raw":
            dest = STAGE / "raw" / f"{stem}_raw.png"
        elif kind == "poseskel":
            dest = STAGE / f"{stem}_poseskel.png"
        elif kind == "animesharp4x_raw":
            dest = STAGE / f"{stem}_animesharp4x_raw.png"
        elif kind == "animesharp2x_raw":
            dest = STAGE / f"{stem}_animesharp2x_raw.png"
        else:
            dest = STAGE / f"{stem}_node{img.get('nodeId')}_{img['filename']}"
        download_image(img, dest)
        saved[kind] = str(dest)
        if kind == "raw":
            shutil.copy2(dest, STAGE / f"{stem}_raw.png")

    meta = {
        "official": True,
        "official_json": str(wf),
        "source": "loaded official UI workflow (not an API-only override graph)",
        "name": args.name,
        "seed": args.seed,
        "face": face,
        "pose": pose,
        "prompt": pos,
        "negative": neg,
        "prompt_id": result["prompt_id"],
        "saved": saved,
        "note": "compare only; not copied to nikki or :8788; formal matte is official-isnet-rematte.py (isnet-anime), color-key is disabled",
    }
    meta_path = STAGE / f"{stem}_meta.json"
    meta_path.write_text(json.dumps(meta, indent=2, ensure_ascii=False), encoding="utf-8")
    print(f"meta {meta_path}")

    rematte_src = saved.get("animesharp4x_raw") or saved.get("animesharp2x_raw")
    if args.skip_rematte:
        print("skipped rematte (--skip-rematte)")
    elif rematte_src:
        try_official_rematte(Path(rematte_src), stem, STAGE)
    print("DONE official compare staging")


if __name__ == "__main__":
    main()
